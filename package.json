{
  "name": "academic-pdf",
  "version": "1.0.0",
  "description": "Export notes as LaTeX-quality PDFs: academic typography, theorem and algorithm blocks, Booktabs tables, table of contents, and live paginated preview.",
  "author": "Giacomo Berti",
  "repository": {
    "type": "git",
    "url": "https://github.com/bertigiacomo/academic-pdf-obsidian"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "sync-css": "node scripts/sync-block-css.mjs",
    "build": "node scripts/sync-block-css.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run src",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "allowScripts": {
    "esbuild@0.25.5": true
  }
}
